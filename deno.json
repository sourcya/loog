{
  "name": "@sourcya/loog",
  "version": "0.1.2",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./logger": "./src/logger.ts",
    "./metrics": "./src/metrics.ts",
    "./hono": "./src/hono/mod.ts",
    "./oak": "./src/oak/mod.ts",
    "./fresh": "./src/fresh/mod.ts"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4",
    "@oak/oak": "jsr:@oak/oak@^17",
    "@fresh/core": "jsr:@fresh/core@^2",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "publish": {
    "include": ["deno.json", "README.md", "LICENSE", "src/**/*.ts"],
    "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended", "jsr"]
    }
  },
  "tasks": {
    "test": "deno test --allow-read --allow-env",
    "lint": "deno lint",
    "check": "deno check src/mod.ts src/hono/mod.ts src/oak/mod.ts src/fresh/mod.ts",
    "publish:dry": "deno publish --dry-run"
  }
}
